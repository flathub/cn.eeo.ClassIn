{
    "app-id": "cn.eeo.ClassIn",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "build-options": {
        "config-opts": [
            "--libdir=/app/lib"
        ],
        "cflags": "-O2 -g",
        "cxxflags": "-O2 -g",
        "env": {
            "PKG_CONFIG_PATH": "/app/lib/pkgconfig:/app/share/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig"
        }
    },
    "tags": [
        "proprietary"
    ],
    "command": "classin-wrapper",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=all",
        "--filesystem=home",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=/mnt",
        "--filesystem=xdg-run/pipewire-0:ro",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.Notifications"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/aclocal",
        "/share/gtk-doc",
        "/share/locale",
        "/share/man",
        "/share/runtime"
    ],
    "modules": [
        {
            "name": "libxcvt",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.x.org/releases/individual/lib/libxcvt-0.1.2.tar.xz",
                    "sha256": "0561690544796e25cfbd71806ba1b0d797ffe464e9796411123e79450f71db38"
                }
            ]
        },
       {
            "name": "libfontenc",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.x.org/releases/individual/lib/libfontenc-1.1.8.tar.xz",
                    "sha256": "7b02c3d405236e0d86806b1de9d6868fe60c313628b38350b032914aa4fd14c6"
                }
            ]
        },
        {
            "name": "libXfont2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.x.org/releases/individual/lib/libXfont2-2.0.6.tar.xz",
                    "sha256": "74ca20017eb0fb3f56d8d5e60685f560fc85e5ff3d84c61c4cb891e40c27aef4"
                }
            ]
        },
        {
            "name": "xvfb",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-xorg",
                "--disable-xnest",
                "--disable-xephyr",
                "--disable-kdrive",
                "--disable-xwayland",
                "--disable-dri",
                "--disable-dri2",
                "--disable-dri3",
                "--disable-glamor",
                "--disable-config-udev",
                "--disable-systemd-logind",
                "--without-systemd-daemon",
                "--disable-unit-tests",
                "--disable-static",
                "--enable-xvfb",
                "--enable-mitshm",
                "--enable-xshmfence",
                "--with-shared-memory-dir=/dev/shm",
                "--enable-composite",
                "--enable-record",
                "--enable-xres",
                "--enable-glx",
                "--with-sha1=libgcrypt",
                "--with-xkb-output=/app/share/X11/xkb/compiled"
            ],
            "sources": [
                {
                "type": "archive",
                "url": "https://www.x.org/pub/individual/xserver/xorg-server-21.1.12.tar.xz",
                "sha256": "1e016e2be1b5ccdd65eac3ea08e54bd13ce8f4f6c3fb32ad6fdac4e71729a90f"
                }
            ]
        },
        {
            "name": "libXrandr",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--disable-devel-docs",
                "--without-doxygen",
                "--without-xmlto",
                "--without-fop",
                "ac_cv_func_malloc_0_nonnull=yes",
                "xorg_cv_malloc0_returns_null=yes"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.x.org/releases/individual/lib/libXrandr-1.5.4.tar.xz",
                    "sha256": "1ad5b065375f4a85915aa60611cc6407c060492a214d7f9daf214be752c3b4d3"
                }
            ]
        },
        {
            "name": "xdotool",
            "buildsystem": "simple",
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS WITHOUT_RPATH_FIX=1 PREFIX=/app",
                "make docs",
                "rm -f docs/html/jquery.js",
                "make install PREFIX=/app INSTALLMAN=/app/share/man"
            ],
            "sources": [
                {
                "type": "archive",
                "url": "https://github.com/jordansissel/xdotool/releases/download/v3.20211022.1/xdotool-3.20211022.1.tar.gz",
                "sha256": "96f0facfde6d78eacad35b91b0f46fecd0b35e474c03e00e30da3fdd345f9ada"
                }
            ]
        },    
        {
            "name": "xrandr",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-silent-rules"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.x.org/releases/individual/app/xrandr-1.5.2.tar.xz",
                    "sha256": "c8bee4790d9058bacc4b6246456c58021db58a87ddda1a9d0139bf5f18f1f240"
                }
            ]
        },
        {
            "name": "python3-dbus",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://dbus.freedesktop.org/releases/dbus-python/dbus-python-1.3.2.tar.gz",
                    "sha256": "ad67819308618b5069537be237f8e68ca1c7fcc95ee4a121fe6845b1418248f8"
                }
            ]
        },
        {
            "name": "python3-gi",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtests=false",
                "-Dpycairo=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/pygobject/3.48/pygobject-3.48.2.tar.xz",
                    "sha256": "0794aeb4a9be31a092ac20621b5f54ec280f9185943d328b105cdae6298ad1a7"
                }
            ]
        },
        {
            "name": "classin-wrapper",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "file",
                    "path": "classin-wrapper"
                },
                {
                    "type": "file",
                    "path": "cn.eeo.ClassIn.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "cn.eeo.ClassIn.xml"
                },
                {
                    "type": "file",
                    "path": "cn.eeo.ClassIn.desktop"
                },
                {
                    "type": "file",
                    "path": "classin.svg"
                }
            ],
            "build-commands": [
                "install -d /app/bin",
                "install classin-wrapper /app/bin/classin-wrapper",
                "install -d /app/share/metainfo",
                "install -m644 cn.eeo.ClassIn.metainfo.xml /app/share/metainfo/cn.eeo.ClassIn.metainfo.xml",
                "install -d /app/share/applications",
                "install -m644 cn.eeo.ClassIn.desktop /app/share/applications/cn.eeo.ClassIn.desktop",
                "install -d /app/share/icons/hicolor/scalable/apps",
                "install -m644 classin.svg /app/share/icons/hicolor/scalable/apps/cn.eeo.ClassIn.svg",
                "install -d /app/share/mime/packages",
                "install -m644 cn.eeo.ClassIn.xml /app/share/mime/packages/cn.eeo.ClassIn.xml"
            ]
        },
        {
            "name": "classin-libs-x64",
            "buildsystem": "simple",
            "only-arches": [
                "x86_64"
            ],
            "build-commands": [
                "install -d /app/lib",
                "install -t /app/lib /usr/lib/x86_64-linux-gnu/libsframe.so*",
                "install -t /app/lib /usr/lib/x86_64-linux-gnu/libbfd-*.so"
            ]
        },
        {
            "name": "classin-libs-aa64",
            "buildsystem": "simple",
            "only-arches": [
                "aarch64"
            ],
            "build-commands": [
                "install -d /app/lib",
                "install -t /app/lib /usr/lib/aarch64-linux-gnu/libsframe.so*",
                "install -t /app/lib /usr/lib/aarch64-linux-gnu/libbfd-*.so"
            ]
        },
        {
            "name": "classin-bridge",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "file",
                    "path": "bridge/classin-bridge.py"
                },
                {
                    "type": "file",
                    "path": "bridge/screenbridge.py"
                },
                {
                    "type": "file",
                    "path": "bridge/screenproxy.c"
                }
            ],
            "build-commands": [
                "install -d /app/bridge",
                "install screenbridge.py classin-bridge.py screenproxy.c /app/bridge/",
                "gcc -shared -fPIC -O2 -o '/app/bridge/screenproxy.so' /app/bridge/screenproxy.c -ldl -lX11 -lxcb -lxcb-shm",
                "rm -f /app/bridge/screenproxy.c"
            ]
        },
        {
            "name": "classin",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "extra-data",
                    "filename": "classin-amd64.deb",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://www.eeo.cn/download/client/classin_6.0.9.1757_amd64.deb",
                    "sha256": "4331e636372929ec5d2cdc45da76a328a0cf82b37079d0acfe6c4a43e9d0ef28",
                    "size": 691996184,
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://www.eeo.cn/sysshare/custom/download_conf.json",
                        "version-query": ".[] | select(.confName==\"eeocn_linux_amd64_version\") | .confValue",
                        "url-query": ".[] | select(.confName==\"eeocn_linux_amd64\") | .confValue"
                    }
                },
                {
                    "type": "extra-data",
                    "filename": "classin-arm64.deb",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://www.eeo.cn/download/client/classin_6.0.9.1758_arm64.deb",
                    "sha256": "1ed8af2bd1d66847653e5a39c6a1f32a5347d01a7a439fd444a476187b833f8a",
                    "size": 663746652,
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://www.eeo.cn/sysshare/custom/download_conf.json",
                        "version-query": ".[] | select(.confName==\"eeocn_linux_arm_version\") | .confValue",
                        "url-query": ".[] | select(.confName==\"eeocn_linux_arm\") | .confValue"
                    }
                },
                {
                    "type": "file",
                    "path": "install.sh"
                }
            ],
            "build-commands": [
                "install -Dm 755 install.sh /app/bin/apply_extra",
                "install /usr/bin/ar /app/bin/ar"
            ]
        }
    ]
}
